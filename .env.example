# ==============================================================================
# NyayaSaathi AI - Environment Configuration Template
# ==============================================================================

APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production

HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=openrouter

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

DATABASE_URL=sqlite:///./data/nyayasaathi.db

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_STORAGE_PATH=./data/qdrant_db
QDRANT_COLLECTION_NAME=nyayasaathi_legal_corpus

EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=384

CHUNK_SIZE=500
CHUNK_OVERLAP=75
RETRIEVAL_TOP_K=10
RRF_K=60
RERANK_ENABLED=false

UPLOAD_DIR=./data/uploads
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
MAX_UPLOAD_SIZE_MB=15

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
